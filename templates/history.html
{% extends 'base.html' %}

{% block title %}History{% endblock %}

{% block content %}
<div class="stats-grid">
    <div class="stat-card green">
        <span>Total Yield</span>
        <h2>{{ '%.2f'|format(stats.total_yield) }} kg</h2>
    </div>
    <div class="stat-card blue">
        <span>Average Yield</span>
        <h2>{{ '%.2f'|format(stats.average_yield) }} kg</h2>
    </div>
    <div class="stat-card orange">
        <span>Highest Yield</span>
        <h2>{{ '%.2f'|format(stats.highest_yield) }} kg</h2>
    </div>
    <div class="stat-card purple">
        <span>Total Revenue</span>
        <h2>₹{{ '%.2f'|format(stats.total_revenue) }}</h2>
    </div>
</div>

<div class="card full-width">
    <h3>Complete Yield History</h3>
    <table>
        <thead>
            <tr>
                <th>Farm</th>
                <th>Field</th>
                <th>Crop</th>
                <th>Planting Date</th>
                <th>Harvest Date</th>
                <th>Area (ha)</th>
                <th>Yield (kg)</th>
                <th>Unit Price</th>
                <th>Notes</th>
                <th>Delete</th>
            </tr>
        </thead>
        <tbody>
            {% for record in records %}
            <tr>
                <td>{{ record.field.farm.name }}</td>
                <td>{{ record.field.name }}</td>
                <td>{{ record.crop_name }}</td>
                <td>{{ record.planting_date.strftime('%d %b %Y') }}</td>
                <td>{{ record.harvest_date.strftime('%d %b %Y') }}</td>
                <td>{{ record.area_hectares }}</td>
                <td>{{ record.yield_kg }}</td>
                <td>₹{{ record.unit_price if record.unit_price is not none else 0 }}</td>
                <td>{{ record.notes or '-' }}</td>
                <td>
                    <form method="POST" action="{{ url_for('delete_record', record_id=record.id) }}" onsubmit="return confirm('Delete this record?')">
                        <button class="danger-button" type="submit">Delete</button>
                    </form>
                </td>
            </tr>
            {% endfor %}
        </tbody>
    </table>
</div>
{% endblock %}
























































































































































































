{% extends 'base.html' %}

{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="stats-grid">
    <div class="stat-card green">
        <span>Total Yield</span>
        <h2>{{ '%.2f'|format(stats.total_yield) }} kg</h2>
    </div>
    <div class="stat-card blue">
        <span>Average Yield</span>
        <h2>{{ '%.2f'|format(stats.average_yield) }} kg</h2>
    </div>
    <div class="stat-card orange">
        <span>Highest Yield</span>
        <h2>{{ '%.2f'|format(stats.highest_yield) }} kg</h2>
    </div>
    <div class="stat-card purple">
        <span>Total Revenue</span>
        <h2>₹{{ '%.2f'|format(stats.total_revenue) }}</h2>
    </div>
</div>

<div class="form-grid">
    <div class="card">
        <h3>Add Farm</h3>
        <form method="POST" action="{{ url_for('add_farm') }}">
            <input type="text" name="name" placeholder="Farm name" required>
            <input type="text" name="location" value="Gorakhpur, Uttar Pradesh" required>
            <input type="text" name="owner" placeholder="Owner name" required>
            <button type="submit">Save Farm</button>
        </form>
    </div>

    <div class="card">
        <h3>Add Field</h3>
        <form method="POST" action="{{ url_for('add_field') }}">
            <select name="farm_id" required>
                <option value="">Select farm</option>
                {% for farm in farms %}
                    <option value="{{ farm.id }}">{{ farm.name }}</option>
                {% endfor %}
            </select>
            <input type="text" name="name" placeholder="Field name" required>
            <input type="number" step="0.01" name="area_hectares" placeholder="Area (hectares)" required>
            <input type="text" name="crop_type" placeholder="Crop type" required>
            <input type="text" name="soil_type" placeholder="Soil type">
            <button type="submit">Save Field</button>
        </form>
    </div>
</div>

<div class="card full-width">
    <h3>Record Harvest</h3>
    <form method="POST" action="{{ url_for('add_record') }}" class="record-form">
        <select name="field_id" required>
            <option value="">Select field</option>
            {% for field in fields %}
                <option value="{{ field.id }}">{{ field.farm.name }} - {{ field.name }}</option>
            {% endfor %}
        </select>
        <input type="text" name="crop_name" placeholder="Crop name" required>
        <input type="date" name="planting_date" required>
        <input type="date" name="harvest_date" required>
        <input type="number" step="0.01" name="area_hectares" placeholder="Area (ha)" required>
        <input type="number" step="0.01" name="yield_kg" placeholder="Yield (kg)" required>
        <input type="number" step="0.01" name="unit_price" placeholder="Price per kg (₹)">
        <textarea name="notes" rows="2" placeholder="Notes"></textarea>
        <button type="submit">Add Record</button>
    </form>
</div>

<div class="card full-width">
    <h3>Farms and Fields</h3>
    <table>
        <thead>
            <tr>
                <th>Farm</th>
                <th>Location</th>
                <th>Owner</th>
                <th>Field Count</th>
            </tr>
        </thead>
        <tbody>
            {% for farm in farms %}
            <tr>
                <td>{{ farm.name }}</td>
                <td>{{ farm.location }}</td>
                <td>{{ farm.owner }}</td>
                <td>{{ farm.fields|length }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="card full-width">
    <h3>Recent Harvest History</h3>
    <table>
        <thead>
            <tr>
                <th>Farm</th>
                <th>Field</th>
                <th>Crop</th>
                <th>Harvest Date</th>
                <th>Yield (kg)</th>
            </tr>
        </thead>
        <tbody>
            {% for record in records %}
            <tr>
                <td>{{ record.field.farm.name }}</td>
                <td>{{ record.field.name }}</td>
                <td>{{ record.crop_name }}</td>
                <td>{{ record.harvest_date.strftime('%d %b %Y') }}</td>
                <td>{{ record.yield_kg }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}










































































































