:root {
    --bg: #f4f8f4;
    --card: #ffffff;
    --green: #2d8f5d;
    --green-soft: #ecf9f1;
    --blue: #1f5fd5;
    --blue-soft: #eaf3ff;
    --orange: #f59f0b;
    --orange-soft: #fff7e8;
    --purple: #7b5cf5;
    --purple-soft: #f2edff;
    --text: #1d2430;
    --muted: #667085;
    --border: #deebea;
    --shadow: 0 10px 24px rgba(18, 34, 26, 0.08);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #edf9f0, #f6fafc);
    color: var(--text);
}

.container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 30px 20px 60px;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255,255,255,0.9);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow);
    padding: 18px 22px;
    margin-bottom: 25px;
}

.topbar h1 {
    margin: 0;
    font-size: 2rem;
    color: var(--green);
}

nav {
    display: flex;
    gap: 12px;
}

nav a {
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 10px;
}

nav a:hover {
    background: var(--green-soft);
    color: var(--green);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 25px;
}

.card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 22px;
    box-shadow: var(--shadow);
}

.full-width {
    margin-top: 25px;
}

.stat-card {
    position: relative;
    overflow: hidden;
}

.stat-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: currentColor;
}

.stat-card.green { background: var(--green-soft); color: var(--green); }
.stat-card.blue { background: var(--blue-soft); color: var(--blue); }
.stat-card.orange { background: var(--orange-soft); color: var(--orange); }
.stat-card.purple { background: var(--purple-soft); color: var(--purple); }

.stat-card span {
    display: block;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
    margin-bottom: 10px;
}

.stat-card h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2vw, 2.2rem);
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(300px, 1fr));
    gap: 20px;
}

form {
    display: grid;
    gap: 12px;
}

.record-form {
    grid-template-columns: repeat(3, minmax(180px, 1fr));
}

input, select, textarea, button {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--border);
    padding: 12px 14px;
    font-size: 0.96rem;
}

textarea {
    min-height: 80px;
    resize: vertical;
}

button {
    background: var(--green);
    color: white;
    border: none;
    cursor: pointer;
    font-weight: 600;
}

button:hover {
    opacity: 0.95;
}

.danger-button {
    background: #d93025;
}

.flash-container {
    margin-bottom: 18px;
}

.flash {
    padding: 12px 14px;
    border-radius: 10px;
    margin-bottom: 8px;
    border: 1px solid transparent;
    font-weight: 600;
}

.flash-success {
    background: #ebfff3;
    border-color: #b9ebc8;
    color: #17673b;
}

.flash-error {
    background: #fff0f0;
    border-color: #f3c7c7;
    color: #af1d1d;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 900px;
}

th, td {
    text-align: left;
    padding: 12px 10px;
    border-bottom: 1px solid var(--border);
}

th {
    background: #f8fbf9;
}

@media (max-width: 900px) {
    .stats-grid, .form-grid, .record-form {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 640px) {
    .stats-grid, .form-grid, .record-form {
        grid-template-columns: 1fr;
    }

    .topbar {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
}













































































































































